# Copy this file to .env and edit. Everything is optional.

# Port the website runs on
PORT=3000

# First-run admin login. Only used when data/admin.json does not exist yet.
# If ADMIN_PASSWORD is empty, a random password is generated and printed in the console.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Largest installer you can upload, in MB
MAX_UPLOAD_MB=2048

# Set to 1 when running behind a proxy/host that terminates HTTPS (Render, Railway, Nginx, Cloudflare)
TRUST_PROXY=0

# Optional: store data and installers on a persistent disk
# DATA_DIR=/var/data/analab
# UPLOAD_DIR=/var/data/analab/uploads
