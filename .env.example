# Copy this file to .env and edit. Everything is optional when running on your own computer.

# Port the website runs on
PORT=3000

# Admin login. In local mode these are only used the first time the admin account is created.
# In GitHub mode (below) they are read on every start, so ALWAYS set ADMIN_PASSWORD there.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---- Free hosting mode: store releases on GitHub (works on Render's free plan) ----
# Fill BOTH to turn it on. Releases and installers are then saved as GitHub Releases in this repo.
# GITHUB_REPO=your-username/your-repo
# GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxx

# Optional: makes sign-in survive restarts if you prefer your own secret (any long random text)
# SESSION_SECRET=

# Largest installer you can upload, in MB (GitHub allows up to 2000)
MAX_UPLOAD_MB=2048

# Set to 1 when running behind a host that provides HTTPS (Render, Railway, Nginx, Cloudflare)
TRUST_PROXY=0

# Local mode only: keep data and installers on a persistent disk
# DATA_DIR=/var/data/analab/data
# UPLOAD_DIR=/var/data/analab/uploads
